# thoth environment variables
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# ComicVine API key. Providers are tried in order and the first match wins:
#   .epub  -> RanobeDB, ComicVine, AniList
#   other  -> ComicVine, RanobeDB, AniList
# Only ComicVine needs a key; RanobeDB and AniList need none. If this is unset,
# ComicVine is skipped and the other providers are used.
# Get one at https://comicvine.gamespot.com/api/ (free, requires an account).
COMICVINE_API_KEY=
