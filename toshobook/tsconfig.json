{
  "extends": [
    "@tsconfig/bases/strictest",
    "@tsconfig/bases/node24"
  ],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true
  }
}
